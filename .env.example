# ===== 업비트 Open API 키 (출금 권한은 빼고 발급!) =====
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ===== 텔레그램 (BotFather 로 봇 만들고 받은 토큰 / 본인 chat id) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 거래 설정 =====
TICKER=KRW-BTC
INTERVAL=minute60
LOOP_SECONDS=60
ORDER_KRW=10000
USE_RATIO=true
ORDER_RATIO=0.3

# ===== 리스크 관리 (0 이면 해당 기능 끔) =====
STOP_LOSS_PCT=-5
TAKE_PROFIT_PCT=8

# ===== 전략 파라미터 (자주 매매하도록 맞춘 값) =====
MA_SHORT=5
MA_LONG=20
RSI_PERIOD=9
RSI_BUY_DIP=38
RSI_BUY_BELOW=78
RSI_SELL_ABOVE=62
BB_PERIOD=20
BB_STD=2

# 매도 방식: legacy(현재) / trend(추세추종) / meanrev(되돌림확인) / split(이유별)
#  legacy  = 데드크로스/RSI과매수/볼린저상단/구름이탈 중 하나라도 (지금 동작, 매매 잦음)
#  trend   = 데드크로스/구름이탈만 (추세 끝까지 보유, 수익실현은 트레일링이 담당)
#  meanrev = 평균회귀를 '되돌림 확인' 뒤에만 (첫 터치로 안 팖)
#  split   = 추세로 산 건 추세로, 눌림목으로 산 건 평균회귀로 청산
#  ※ 바꾸기 전 반드시 DRY_RUN=true 로 두고 backtest.py 로 비교!
SELL_MODE=legacy

# 매수 방식: all(기본) / dip_only(눌림목 과매도에서만 = 순수 평균회귀)
#  all      = 눌림목 + 골든크로스 + 구름 상향돌파 (지금 동작)
#  dip_only = 볼린저 하단+RSI 과매도에서만 매수. 돌파 추격을 안 함.
#             진입·청산을 모두 평균회귀로 통일 → '사자마자 던지는' 방향 모순이 사라짐.
#             (USE_TREND_FILTER=true 면 '추세 위 눌림목'에서만 사서 하락장엔 대부분 현금 대기)
BUY_MODE=all

# ===== 안전장치 =====
# ★★★ 처음엔 반드시 true (모의매매, 실제 주문 안 함). 검증 끝나면 false 로. ★★★
DRY_RUN=true
SUMMARY_EVERY_MIN=360
STATE_FILE=state.json
DRY_RUN_START_KRW=1000000

# ===== 데이터 파이프라인(DE) 설정 =====
DB_FILE=market.db
PIPELINE_LOOP_SECONDS=60
CANDLE_COUNT=200
