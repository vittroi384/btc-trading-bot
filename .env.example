# ===== 업비트 Open API 키 (출금 권한은 빼고 발급!) =====
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ===== 텔레그램 (BotFather 로 봇 만들고 받은 토큰 / 본인 chat id) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 거래 설정 =====
# TICKER  = 파이프라인 수집·백테스트·차트가 쓰는 기준 종목 (1개)
# TICKERS = 매매봇이 동시에 굴릴 종목들 (쉼표 구분). 파이프라인은 TICKERS 를 수집하지 않음
TICKER=KRW-BTC
TICKERS=KRW-BTC,KRW-ETH
INTERVAL=minute60
LOOP_SECONDS=60
ORDER_KRW=10000
USE_RATIO=true
ORDER_RATIO=0.3

# ===== 리스크 관리 (0 이면 해당 기능 끔) =====
STOP_LOSS_PCT=-5
TAKE_PROFIT_PCT=8
# 트레일링 스탑(%). 0 보다 크면 고정 익절(TAKE_PROFIT_PCT)은 무시되고 트레일링으로 매도
TRAIL_STOP_PCT=4
# 추세 필터: true 면 종가가 TREND_MA 이평선 위에 있을 때만 눌림목 매수 허용
USE_TREND_FILTER=true
TREND_MA=100

# ===== 전략 파라미터 (자주 매매하도록 맞춘 값) =====
MA_SHORT=5
MA_LONG=20
RSI_PERIOD=9
RSI_BUY_DIP=38
RSI_BUY_BELOW=78
RSI_SELL_ABOVE=62
BB_PERIOD=20
BB_STD=2

# ===== 안전장치 =====
# ★★★ 처음엔 반드시 true (모의매매, 실제 주문 안 함). 검증 끝나면 false 로. ★★★
DRY_RUN=true
SUMMARY_EVERY_MIN=360
STATE_FILE=state.json
DRY_RUN_START_KRW=1000000

# ===== 데이터 파이프라인(DE) 설정 =====
DB_FILE=market.db
PIPELINE_LOOP_SECONDS=60
CANDLE_COUNT=200

# ===== 웹 대시보드 (dashboard.py) =====
# 관리자 계정은 필수 (없으면 대시보드가 시작되지 않음). 읽기 전용 계정은 선택.
# HTTP Basic Auth 이며 TLS 는 없으므로 사설망·SSH 터널 안에서만 열 것.
DASH_USER=
DASH_PASS=
DASH_VIEW_USER=
DASH_VIEW_PASS=
DASH_PORT=80
