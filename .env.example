# ===== 업비트 Open API 키 (출금 권한은 빼고 발급!) =====
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ===== 텔레그램 (BotFather 로 봇 만들고 받은 토큰 / 본인 chat id) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 거래 설정 =====
TICKER=KRW-BTC
INTERVAL=minute60
LOOP_SECONDS=60
ORDER_KRW=10000
USE_RATIO=true
ORDER_RATIO=0.3

# ===== 리스크 관리 (0 이면 해당 기능 끔) =====
STOP_LOSS_PCT=-5
TAKE_PROFIT_PCT=8

# ===== 전략 파라미터 (자주 매매하도록 맞춘 값) =====
MA_SHORT=5
MA_LONG=20
RSI_PERIOD=9
RSI_BUY_DIP=38
RSI_BUY_BELOW=78
RSI_SELL_ABOVE=62
BB_PERIOD=20
BB_STD=2

# ===== 안전장치 =====
# ★★★ 처음엔 반드시 true (모의매매, 실제 주문 안 함). 검증 끝나면 false 로. ★★★
DRY_RUN=true
SUMMARY_EVERY_MIN=360
STATE_FILE=state.json
DRY_RUN_START_KRW=1000000

# ===== 데이터 파이프라인(DE) 설정 =====
DB_FILE=market.db
PIPELINE_LOOP_SECONDS=60
CANDLE_COUNT=200
