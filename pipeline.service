# 데이터 파이프라인(pipeline.py)을 24시간 자동 실행 + 꺼지면 자동 재시작.
# 매매봇(trading-bot.service)과 '별도로' 돌린다. (수집/저장은 봇과 독립적으로 계속)
# 설치 방법은 README 의 "24시간 자동 실행" 부분 참고.
# ※ systemd 설정은 한 줄 끝에 주석을 못 달아서, 설명을 전부 윗줄에 적었음.

[Unit]
Description=Crypto Data Pipeline (ingest-transform-quality)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ↓↓↓ 본인 환경에 맞게 사용자/경로 수정 (오라클 우분투 기본 계정은 보통 ubuntu)
User=ubuntu
WorkingDirectory=/home/ubuntu/btc-trading-bot
ExecStart=/home/ubuntu/btc-trading-bot/venv/bin/python /home/ubuntu/btc-trading-bot/pipeline.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
